  name          String
  storageKey    String       @unique
  fileName      String
  contentType   String
  sizeBytes     Int
  uploadedById  String
  uploadedBy    User         @relation("CommunicationMediaUploader", fields: [uploadedById], references: [id], onDelete: Restrict)
  createdAt     DateTime     @default(now())

  @@index([schoolId, createdAt(sort: Desc)])
  @@index([publicationId, createdAt(sort: Desc)])
  @@map("communication_media")
}

model NewsletterSubscriber {
  id             String    @id @default(cuid())
  schoolId       String
  school         School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  email          String
  name           String?
  isActive       Boolean   @default(true)
  subscribedAt   DateTime  @default(now())
  unsubscribedAt DateTime?

  @@unique([schoolId, email])
  @@index([schoolId, isActive, subscribedAt(sort: Desc)])
  @@map("newsletter_subscribers")
}


model PilotRun {
  id          String      @id @default(cuid())
  schoolId    String
  school      School      @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name        String
  status      PilotStatus @default(PLANNED)
  startsAt    DateTime?
  endsAt      DateTime?
  notes       String?
  createdById String
  createdBy   User        @relation("PilotRunCreator", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  checklist PilotChecklistItem[]
  issues    PilotIssue[]
  approval  LaunchApproval?

  @@index([schoolId, status, createdAt(sort: Desc)])
  @@map("pilot_runs")
}

model PilotChecklistItem {
  id           String               @id @default(cuid())
  pilotRunId   String
  pilotRun     PilotRun             @relation(fields: [pilotRunId], references: [id], onDelete: Cascade)
  key          String
  area         String
  label        String
  status       PilotChecklistStatus @default(NOT_STARTED)
  evidence     String?
  verifiedById String?
  verifiedBy   User?                @relation("PilotChecklistVerifier", fields: [verifiedById], references: [id], onDelete: Restrict)
  verifiedAt   DateTime?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  @@unique([pilotRunId, key])
  @@index([pilotRunId, area, status])
  @@map("pilot_checklist_items")
}

model PilotIssue {
  id           String           @id @default(cuid())
  schoolId     String
  school       School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  campusId     String?
  campus       Campus?          @relation(fields: [campusId], references: [id], onDelete: Restrict)
  pilotRunId   String
  pilotRun     PilotRun         @relation(fields: [pilotRunId], references: [id], onDelete: Cascade)
  title        String
  description  String
  route        String?
  severity     PilotIssueSeverity
  status       PilotIssueStatus @default(OPEN)
  resolution   String?
  reportedById String
  reportedBy   User             @relation("PilotIssueReporter", fields: [reportedById], references: [id], onDelete: Restrict)
  resolvedById String?
  resolvedBy   User?            @relation("PilotIssueResolver", fields: [resolvedById], references: [id], onDelete: Restrict)
  resolvedAt   DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([schoolId, status, severity])
  @@index([pilotRunId, createdAt(sort: Desc)])
  @@index([campusId, status])
  @@map("pilot_issues")
}

model LaunchApproval {
  id           String               @id @default(cuid())
  pilotRunId   String               @unique
  pilotRun     PilotRun             @relation(fields: [pilotRunId], references: [id], onDelete: Cascade)
  status       LaunchApprovalStatus @default(DRAFT)
  summary      String?
  approvedById String?
  approvedBy   User?                @relation("LaunchApprover", fields: [approvedById], references: [id], onDelete: Restrict)
  approvedAt   DateTime?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  @@index([status, approvedAt(sort: Desc)])
  @@map("launch_approvals")
}

model AuditLog {
  id          String   @id @default(cuid())
  schoolId    String
  school      School   @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  campusId    String?
  campus      Campus?  @relation(fields: [campusId], references: [id], onDelete: Restrict)
  actorUserId String?
  actor       User?    @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  action      String
  entityType  String
  entityId    String?
  before      Json?
  after       Json?
  requestId   String?
  ipAddress   String?
  userAgent   String?
  occurredAt  DateTime @default(now())

  @@index([schoolId, occurredAt(sort: Desc)])
  @@index([campusId, occurredAt(sort: Desc)])
  @@index([actorUserId, occurredAt(sort: Desc)])
  @@map("audit_logs")
}

model ErrorLog {
  id          String      @id @default(cuid())
  schoolId    String?
  school      School?     @relation(fields: [schoolId], references: [id], onDelete: SetNull)
  campusId    String?
  campus      Campus?     @relation(fields: [campusId], references: [id], onDelete: SetNull)
  userId      String?
  user        User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  severity    LogSeverity @default(ERROR)
  message     String
  stack       String?
  fingerprint String?
  requestId   String?
  path        String?
  context     Json?
  occurredAt  DateTime    @default(now())

  @@index([severity, occurredAt(sort: Desc)])
  @@index([schoolId, occurredAt(sort: Desc)])
  @@index([fingerprint])
  @@map("error_logs")
}
