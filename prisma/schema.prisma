model AttendanceRegister {
  id            String                   @id @default(cuid())
  schoolId      String
  school        School                   @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  campusId      String
  campus        Campus                   @relation(fields: [campusId], references: [id], onDelete: Restrict)
  termId        String
  term          Term                     @relation(fields: [termId], references: [id], onDelete: Restrict)
  classArmId    String
  classArm      ClassArm                 @relation(fields: [classArmId], references: [id], onDelete: Restrict)
  registerDate  DateTime                 @db.Date
  status        AttendanceRegisterStatus @default(DRAFT)
  createdById   String
  createdBy     User                     @relation("AttendanceCreator", fields: [createdById], references: [id], onDelete: Restrict)
  submittedById String?
  submittedBy   User?                    @relation("AttendanceSubmitter", fields: [submittedById], references: [id], onDelete: Restrict)
  submittedAt   DateTime?
  lockedById    String?
