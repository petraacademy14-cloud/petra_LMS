  createdAt   DateTime                  @default(now())
  updatedAt   DateTime                  @updatedAt

  deliveryDrafts CommunicationDeliveryDraft[]

  @@unique([schoolId, name, channel])
  @@index([schoolId, kind, isActive])
  @@map("communication_templates")
}

model Announcement {
  id            String                @id @default(cuid())
