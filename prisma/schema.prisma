generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  OWNER
  ADMIN
  TEACHER
}

enum MembershipStatus {
  INVITED
  ACTIVE
  SUSPENDED
}

enum TermKind {
  FIRST
  SECOND
  THIRD
  CUSTOM
}

enum LogSeverity {
  INFO
  WARNING
  ERROR
  CRITICAL
}

enum Gender {
  MALE
  FEMALE
}

enum StudentStatus {
  ACTIVE
  ARCHIVED
  WITHDRAWN
  GRADUATED
}

enum EnrollmentStatus {
  CURRENT
  PROMOTED
  TRANSFERRED
  WITHDRAWN
  GRADUATED
}

enum GuardianRelationship {
  FATHER
  MOTHER
  GUARDIAN
  SIBLING
  RELATIVE
  OTHER
}

model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions                 Session[]
  accounts                 Account[]
  memberships              SchoolMembership[]
  auditEvents              AuditLog[]         @relation("AuditActor")
  errorEvents              ErrorLog[]
  uploadedStudentDocuments StudentDocument[]

  @@index([email])
  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("sessions")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verifications")
}

model School {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  timezone  String   @default("Africa/Lagos")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  campuses           Campus[]
  memberships        SchoolMembership[]
  sessions           AcademicSession[]
  classLevels        ClassLevel[]
  subjects           Subject[]
  auditEvents        AuditLog[]
  errorEvents        ErrorLog[]
  students           Student[]
  guardians          Guardian[]
  admissionSequences AdmissionSequence[]

  @@map("schools")
}

model Campus {
  id        String   @id @default(cuid())
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name      String
  code      String
  city      String
  state     String   @default("Anambra")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships        SchoolMembership[]
  classArms          ClassArm[]
  campusSubjects     CampusSubject[]
  terms              Term[]
  auditEvents        AuditLog[]
  errorEvents        ErrorLog[]
  students           Student[]
  enrollments        Enrollment[]
  studentDocuments   StudentDocument[]
  admissionSequences AdmissionSequence[]

  @@unique([schoolId, code])
  @@unique([schoolId, name])
  @@index([schoolId, isActive])
  @@map("campuses")
}

model SchoolMembership {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  schoolId  String
  school    School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  campusId  String?
  campus    Campus?          @relation(fields: [campusId], references: [id], onDelete: Cascade)
  role      Role
  status    MembershipStatus @default(INVITED)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@unique([userId, schoolId, campusId])
  @@index([schoolId, role, status])
  @@index([campusId, role, status])
  @@map("school_memberships")
}

model AcademicSession {
  id        String   @id @default(cuid())
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name      String
  startsOn  DateTime @db.Date
  endsOn    DateTime @db.Date
  isCurrent Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  terms       Term[]
  enrollments Enrollment[]

  @@unique([schoolId, name])
  @@index([schoolId, isCurrent])
  @@map("academic_sessions")
}

model Term {
  id                String          @id @default(cuid())
  academicSessionId String
  academicSession   AcademicSession @relation(fields: [academicSessionId], references: [id], onDelete: Cascade)
  campusId          String
  campus            Campus          @relation(fields: [campusId], references: [id], onDelete: Cascade)
  name              String
  kind              TermKind
  startsOn          DateTime        @db.Date
  endsOn            DateTime        @db.Date
  isCurrent         Boolean         @default(false)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@unique([academicSessionId, campusId, kind])
  @@index([campusId, isCurrent])
  @@map("terms")
}

model ClassLevel {
  id        String   @id @default(cuid())
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name      String
  code      String
  sortOrder Int
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  arms ClassArm[]

  @@unique([schoolId, code])
  @@unique([schoolId, sortOrder])
  @@map("class_levels")
}

model ClassArm {
  id           String       @id @default(cuid())
  campusId     String
  campus       Campus       @relation(fields: [campusId], references: [id], onDelete: Cascade)
  classLevelId String
  classLevel   ClassLevel   @relation(fields: [classLevelId], references: [id], onDelete: Cascade)
  name         String
  code         String
  capacity     Int?
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  enrollments  Enrollment[]

  @@unique([campusId, classLevelId, code])
  @@index([campusId, isActive])
  @@map("class_arms")
}

model Subject {
  id        String   @id @default(cuid())
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name      String
  code      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  campusSubjects CampusSubject[]

  @@unique([schoolId, code])
  @@map("subjects")
}

model CampusSubject {
  id        String   @id @default(cuid())
  campusId  String
  campus    Campus   @relation(fields: [campusId], references: [id], onDelete: Cascade)
  subjectId String
  subject   Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([campusId, subjectId])
  @@index([campusId, isActive])
  @@map("campus_subjects")
}

model AdmissionSequence {
  id         String   @id @default(cuid())
  schoolId   String
  school     School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  campusId   String
  campus     Campus   @relation(fields: [campusId], references: [id], onDelete: Cascade)
  year       Int
  nextNumber Int      @default(1)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([campusId, year])
  @@index([schoolId, year])
  @@map("admission_sequences")
}

model Student {
  id              String        @id @default(cuid())
  schoolId        String
  school          School        @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  campusId        String
  campus          Campus        @relation(fields: [campusId], references: [id], onDelete: Restrict)
  admissionNumber String
  firstName       String
  middleName      String?
  lastName        String
  preferredName   String?
  gender          Gender
  dateOfBirth     DateTime?     @db.Date
  admissionDate   DateTime      @db.Date
  status          StudentStatus @default(ACTIVE)
  address         String?
  notes           String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  guardians   StudentGuardian[]
  enrollments Enrollment[]
  documents   StudentDocument[]

  @@unique([schoolId, admissionNumber])
  @@index([campusId, status, lastName, firstName])
  @@index([schoolId, lastName, firstName])
  @@map("students")
}

model Guardian {
  id         String   @id @default(cuid())
  schoolId   String
  school     School   @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  firstName  String
  lastName   String
  phone      String
  email      String?
  address    String?
  occupation String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  students StudentGuardian[]

  @@index([schoolId, phone])
  @@index([schoolId, lastName, firstName])
  @@map("guardians")
}

model StudentGuardian {
  id           String               @id @default(cuid())
  studentId    String
  student      Student              @relation(fields: [studentId], references: [id], onDelete: Cascade)
  guardianId   String
  guardian     Guardian             @relation(fields: [guardianId], references: [id], onDelete: Cascade)
  relationship GuardianRelationship
  isPrimary    Boolean              @default(false)
  livesWith    Boolean              @default(false)
  canPickup    Boolean              @default(true)
  createdAt    DateTime             @default(now())

  @@unique([studentId, guardianId])
  @@index([guardianId])
  @@map("student_guardians")
}

model Enrollment {
  id                String           @id @default(cuid())
  studentId         String
  student           Student          @relation(fields: [studentId], references: [id], onDelete: Restrict)
  campusId          String
  campus            Campus           @relation(fields: [campusId], references: [id], onDelete: Restrict)
  academicSessionId String
  academicSession   AcademicSession  @relation(fields: [academicSessionId], references: [id], onDelete: Restrict)
  classArmId        String
  classArm          ClassArm         @relation(fields: [classArmId], references: [id], onDelete: Restrict)
  status            EnrollmentStatus @default(CURRENT)
  startsOn          DateTime         @db.Date
  endsOn            DateTime?        @db.Date
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@unique([studentId, academicSessionId])
  @@index([campusId, classArmId, status])
  @@index([academicSessionId, status])
  @@map("enrollments")
}

model StudentDocument {
  id           String   @id @default(cuid())
  studentId    String
  student      Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  campusId     String
  campus       Campus   @relation(fields: [campusId], references: [id], onDelete: Restrict)
  name         String
  storageKey   String   @unique
  fileName     String
  contentType  String
  sizeBytes    Int
  uploadedById String
  uploadedBy   User     @relation(fields: [uploadedById], references: [id], onDelete: Restrict)
  createdAt    DateTime @default(now())

  @@index([studentId, createdAt(sort: Desc)])
  @@index([campusId, createdAt(sort: Desc)])
  @@map("student_documents")
}

model AuditLog {
  id          String   @id @default(cuid())
  schoolId    String
  school      School   @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  campusId    String?
  campus      Campus?  @relation(fields: [campusId], references: [id], onDelete: Restrict)
  actorUserId String?
  actor       User?    @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  action      String
  entityType  String
  entityId    String?
  before      Json?
  after       Json?
  requestId   String?
  ipAddress   String?
  userAgent   String?
  occurredAt  DateTime @default(now())

  @@index([schoolId, occurredAt(sort: Desc)])
  @@index([campusId, occurredAt(sort: Desc)])
  @@index([actorUserId, occurredAt(sort: Desc)])
  @@map("audit_logs")
}

model ErrorLog {
  id          String      @id @default(cuid())
  schoolId    String?
  school      School?     @relation(fields: [schoolId], references: [id], onDelete: SetNull)
  campusId    String?
  campus      Campus?     @relation(fields: [campusId], references: [id], onDelete: SetNull)
  userId      String?
  user        User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  severity    LogSeverity @default(ERROR)
  message     String
  stack       String?
  fingerprint String?
  requestId   String?
  path        String?
  context     Json?
  occurredAt  DateTime    @default(now())

  @@index([severity, occurredAt(sort: Desc)])
  @@index([schoolId, occurredAt(sort: Desc)])
  @@index([fingerprint])
  @@map("error_logs")
}
