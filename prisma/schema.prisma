  @@unique([schemeId, label])
  @@unique([schemeId, sortOrder])
  @@map("grade_bands")
}

model ResultSheet {
  id                  String            @id @default(cuid())
  schoolId            String
  school              School            @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  campusId            String
  campus              Campus            @relation(fields: [campusId], references: [id], onDelete: Restrict)
  termId              String
  term                Term              @relation(fields: [termId], references: [id], onDelete: Restrict)
  classArmId          String
  classArm            ClassArm          @relation(fields: [classArmId], references: [id], onDelete: Restrict)
  subjectId           String
  subject             Subject           @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  gradingSchemeId     String
  gradingScheme       GradingScheme     @relation(fields: [gradingSchemeId], references: [id], onDelete: Restrict)
  teacherMembershipId String
  teacherMembership   SchoolMembership  @relation(fields: [teacherMembershipId], references: [id], onDelete: Restrict)
  status              ResultSheetStatus @default(DRAFT)
  submittedById       String?
  submittedBy         User?             @relation("ResultSubmitter", fields: [submittedById], references: [id], onDelete: Restrict)
  submittedAt         DateTime?
  approvedById        String?
  approvedBy          User?             @relation("ResultApprover", fields: [approvedById], references: [id], onDelete: Restrict)
  approvedAt          DateTime?
  publishedById       String?
  publishedBy         User?             @relation("ResultPublisher", fields: [publishedById], references: [id], onDelete: Restrict)
  publishedAt         DateTime?
  lockedById          String?
  lockedBy            User?             @relation("ResultLocker", fields: [lockedById], references: [id], onDelete: Restrict)
  lockedAt            DateTime?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  components AssessmentComponent[]
  entries    ResultEntry[]

  @@unique([termId, classArmId, subjectId])
  @@index([campusId, termId, status])
  @@index([teacherMembershipId, termId, status])
  @@map("result_sheets")
}

model AssessmentComponent {
