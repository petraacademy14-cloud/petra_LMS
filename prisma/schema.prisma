generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}


enum CommunicationAudience {
  SCHOOL
  CAMPUS
  CLASS
}

enum CommunicationChannel {
  WHATSAPP
  EMAIL
  PRINT
}

enum CommunicationTemplateKind {
  GENERAL
  FEE_REMINDER
  RESULT_NOTICE
  ATTENDANCE_NOTICE
}

enum ContentStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  PUBLISHED
  ARCHIVED
}

enum PublicationKind {
  NEWS
  EVENT
  ACHIEVEMENT
}


enum PilotStatus {
  PLANNED
  ACTIVE
  BLOCKED
  COMPLETED
}

enum PilotChecklistStatus {
  NOT_STARTED
  IN_PROGRESS
  PASSED
  FAILED
  BLOCKED
}

enum PilotIssueSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum PilotIssueStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  ACCEPTED_RISK
}

enum LaunchApprovalStatus {
  DRAFT
  APPROVED
  REVOKED
}

enum Role {
  OWNER
  ADMIN
  TEACHER
}

enum MembershipStatus {
  INVITED
  ACTIVE
  SUSPENDED
}

enum TermKind {
  FIRST
  SECOND
  THIRD
  CUSTOM
}

enum LogSeverity {
  INFO
  WARNING
  ERROR
  CRITICAL
}

enum Gender {
  MALE
  FEMALE
}

enum StudentStatus {
  ACTIVE
  ARCHIVED
  WITHDRAWN
  GRADUATED
}

enum EnrollmentStatus {
  CURRENT
  PROMOTED
  TRANSFERRED
  WITHDRAWN
  GRADUATED
}

enum GuardianRelationship {
  FATHER
  MOTHER
  GUARDIAN
  SIBLING
  RELATIVE
  OTHER
}

enum PaymentMethod {
  CASH
  TRANSFER
  POS
  ONLINE
}

enum StudentChargeType {
  CHARGE
  DISCOUNT
}

enum LedgerEntryType {
  CHARGE
  DISCOUNT
  PAYMENT
  REVERSAL
}

enum ReminderChannel {
  PRINT
  WHATSAPP
  SMS
  EMAIL
}

enum ReconciliationStatus {
  OPEN
  RECONCILED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum AttendanceRegisterStatus {
  DRAFT
  SUBMITTED
  LOCKED
}

enum AssessmentKind {
  CONTINUOUS_ASSESSMENT
  EXAM
}

enum ResultSheetStatus {
  DRAFT
  SUBMITTED
  APPROVED
  PUBLISHED
  LOCKED
}

model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions                     Session[]
  accounts                     Account[]
  memberships                  SchoolMembership[]
  auditEvents                  AuditLog[]             @relation("AuditActor")
  errorEvents                  ErrorLog[]
  uploadedStudentDocuments     StudentDocument[]
  recordedPayments             Payment[]              @relation("PaymentRecorder")
  paymentReversals             PaymentReversal[]      @relation("PaymentReversalRecorder")
  chargeReversals              ChargeReversal[]       @relation("ChargeReversalRecorder")
  feeLedgerEntries             FeeLedgerEntry[]       @relation("FeeLedgerRecorder")
  feeReminders                 FeeReminder[]          @relation("FeeReminderGenerator")
  reconciliations              ReconciliationBatch[]  @relation("ReconciliationRecorder")
  attendanceRegistersCreated   AttendanceRegister[]   @relation("AttendanceCreator")
  attendanceRegistersSubmitted AttendanceRegister[]   @relation("AttendanceSubmitter")
  attendanceRegistersLocked    AttendanceRegister[]   @relation("AttendanceLocker")
  attendanceEntriesMarked      AttendanceEntry[]      @relation("AttendanceMarker")
  attendanceCorrections        AttendanceCorrection[] @relation("AttendanceCorrector")
  scoresMarked                 StudentScore[]         @relation("ScoreMarker")
  scoreCorrections             ScoreCorrection[]      @relation("ScoreCorrector")
  resultSheetsSubmitted        ResultSheet[]          @relation("ResultSubmitter")
  resultSheetsApproved         ResultSheet[]          @relation("ResultApprover")
  resultSheetsPublished        ResultSheet[]          @relation("ResultPublisher")
  resultSheetsLocked           ResultSheet[]          @relation("ResultLocker")
  communicationTemplatesCreated CommunicationTemplate[] @relation("CommunicationTemplateCreator")
  announcementsAuthored          Announcement[]          @relation("AnnouncementAuthor")
  announcementsReviewed         Announcement[]          @relation("AnnouncementReviewer")
  announcementsPublished        Announcement[]          @relation("AnnouncementPublisher")
  deliveryDraftsGenerated        CommunicationDeliveryDraft[] @relation("DeliveryDraftGenerator")
  publicationsAuthored           Publication[]           @relation("PublicationAuthor")
  publicationsReviewed           Publication[]           @relation("PublicationReviewer")
  publicationsPublished          Publication[]           @relation("PublicationPublisher")
  communicationMediaUploaded     CommunicationMedia[]    @relation("CommunicationMediaUploader")
  pilotRunsCreated               PilotRun[]               @relation("PilotRunCreator")
  pilotChecklistVerified         PilotChecklistItem[]     @relation("PilotChecklistVerifier")
  pilotIssuesReported            PilotIssue[]             @relation("PilotIssueReporter")
  pilotIssuesResolved            PilotIssue[]             @relation("PilotIssueResolver")
  launchApprovals                LaunchApproval[]         @relation("LaunchApprover")

  @@index([email])
  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("sessions")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verifications")
}

model School {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  timezone  String   @default("Africa/Lagos")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  campuses            Campus[]
  memberships         SchoolMembership[]
  sessions            AcademicSession[]
  classLevels         ClassLevel[]
  subjects            Subject[]
  auditEvents         AuditLog[]
  errorEvents         ErrorLog[]
  students            Student[]
  guardians           Guardian[]
  admissionSequences  AdmissionSequence[]
  feeCategories       FeeCategory[]
  feeStructures       FeeStructure[]
  studentFeeAccounts  StudentFeeAccount[]
  studentCharges      StudentCharge[]
  payments            Payment[]
  feeLedgerEntries    FeeLedgerEntry[]
  receiptSequences    ReceiptSequence[]
  feeReminders        FeeReminder[]
  reconciliations     ReconciliationBatch[]
  gradingSchemes      GradingScheme[]
  teachingAssignments TeachingAssignment[]
  attendanceRegisters AttendanceRegister[]
  resultSheets        ResultSheet[]
  communicationTemplates CommunicationTemplate[]
  announcements       Announcement[]
  deliveryDrafts      CommunicationDeliveryDraft[]
  contentCategories   ContentCategory[]
  publications        Publication[]
  communicationMedia  CommunicationMedia[]
  pilotIssues         PilotIssue[]
  newsletterSubscribers NewsletterSubscriber[]
  pilotRuns           PilotRun[]
  pilotIssues         PilotIssue[]

  @@map("schools")
}

model Campus {
  id        String   @id @default(cuid())
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name      String
  code      String
  city      String
  state     String   @default("Anambra")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships         SchoolMembership[]
  classArms           ClassArm[]
  campusSubjects      CampusSubject[]
  terms               Term[]
  auditEvents         AuditLog[]
  errorEvents         ErrorLog[]
  students            Student[]
  enrollments         Enrollment[]
  studentDocuments    StudentDocument[]
  admissionSequences  AdmissionSequence[]
  feeStructures       FeeStructure[]
  studentFeeAccounts  StudentFeeAccount[]
  studentCharges      StudentCharge[]
  payments            Payment[]
  feeLedgerEntries    FeeLedgerEntry[]
  receiptSequences    ReceiptSequence[]
  feeReminders        FeeReminder[]
  reconciliations     ReconciliationBatch[]
  teachingAssignments TeachingAssignment[]
  attendanceRegisters AttendanceRegister[]
  resultSheets        ResultSheet[]
  announcements       Announcement[]
  publications        Publication[]
  communicationMedia  CommunicationMedia[]

  @@unique([schoolId, code])
  @@unique([schoolId, name])
  @@index([schoolId, isActive])
  @@map("campuses")
}

model SchoolMembership {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  schoolId  String
  school    School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  campusId  String?
  campus    Campus?          @relation(fields: [campusId], references: [id], onDelete: Cascade)
  role      Role
  status    MembershipStatus @default(INVITED)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  teachingAssignments TeachingAssignment[]
  resultSheets        ResultSheet[]

  @@unique([userId, schoolId, campusId])
  @@index([schoolId, role, status])
  @@index([campusId, role, status])
  @@map("school_memberships")
}

model AcademicSession {
  id        String   @id @default(cuid())
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name      String
  startsOn  DateTime @db.Date
  endsOn    DateTime @db.Date
  isCurrent Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  terms       Term[]
  enrollments Enrollment[]

  @@unique([schoolId, name])
  @@index([schoolId, isCurrent])
  @@map("academic_sessions")
}

model Term {
  id                String          @id @default(cuid())
  academicSessionId String
  academicSession   AcademicSession @relation(fields: [academicSessionId], references: [id], onDelete: Cascade)
  campusId          String
  campus            Campus          @relation(fields: [campusId], references: [id], onDelete: Cascade)
  name              String
  kind              TermKind
  startsOn          DateTime        @db.Date
  endsOn            DateTime        @db.Date
  isCurrent         Boolean         @default(false)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  feeStructures       FeeStructure[]
  studentCharges      StudentCharge[]
  payments            Payment[]
  feeLedgerEntries    FeeLedgerEntry[]
  feeReminders        FeeReminder[]
  teachingAssignments TeachingAssignment[]
  attendanceRegisters AttendanceRegister[]
  resultSheets        ResultSheet[]

  @@unique([academicSessionId, campusId, kind])
  @@index([campusId, isCurrent])
  @@map("terms")
}

model ClassLevel {
  id        String   @id @default(cuid())
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name      String
  code      String
  sortOrder Int
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  arms          ClassArm[]
  feeStructures FeeStructure[]

  @@unique([schoolId, code])
  @@unique([schoolId, sortOrder])
  @@map("class_levels")
}

model ClassArm {
  id                  String               @id @default(cuid())
  campusId            String
  campus              Campus               @relation(fields: [campusId], references: [id], onDelete: Cascade)
  classLevelId        String
  classLevel          ClassLevel           @relation(fields: [classLevelId], references: [id], onDelete: Cascade)
  name                String
  code                String
  capacity            Int?
  isActive            Boolean              @default(true)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  enrollments         Enrollment[]
  studentFeeAccounts  StudentFeeAccount[]
  teachingAssignments TeachingAssignment[]
  attendanceRegisters AttendanceRegister[]
  resultSheets        ResultSheet[]
  announcements       Announcement[]

  @@unique([campusId, classLevelId, code])
  @@index([campusId, isActive])
  @@map("class_arms")
}

model Subject {
  id        String   @id @default(cuid())
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name      String
  code      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  campusSubjects      CampusSubject[]
  teachingAssignments TeachingAssignment[]
  resultSheets        ResultSheet[]

  @@unique([schoolId, code])
  @@map("subjects")
}

model CampusSubject {
  id        String   @id @default(cuid())
  campusId  String
  campus    Campus   @relation(fields: [campusId], references: [id], onDelete: Cascade)
  subjectId String
  subject   Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([campusId, subjectId])
  @@index([campusId, isActive])
  @@map("campus_subjects")
}

model AdmissionSequence {
  id         String   @id @default(cuid())
  schoolId   String
  school     School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  campusId   String
  campus     Campus   @relation(fields: [campusId], references: [id], onDelete: Cascade)
  year       Int
  nextNumber Int      @default(1)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([campusId, year])
  @@index([schoolId, year])
  @@map("admission_sequences")
}

model Student {
  id              String        @id @default(cuid())
  schoolId        String
  school          School        @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  campusId        String
  campus          Campus        @relation(fields: [campusId], references: [id], onDelete: Restrict)
  admissionNumber String
  firstName       String
  middleName      String?
  lastName        String
  preferredName   String?
  gender          Gender
  dateOfBirth     DateTime?     @db.Date
  admissionDate   DateTime      @db.Date
  status          StudentStatus @default(ACTIVE)
  address         String?
  notes           String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  guardians         StudentGuardian[]
  enrollments       Enrollment[]
  documents         StudentDocument[]
  attendanceEntries AttendanceEntry[]
  scores            StudentScore[]
  resultEntries     ResultEntry[]

  @@unique([schoolId, admissionNumber])
  @@index([campusId, status, lastName, firstName])
  @@index([schoolId, lastName, firstName])
  @@map("students")
}

model Guardian {
  id         String   @id @default(cuid())
  schoolId   String
  school     School   @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  firstName  String
  lastName   String
  phone      String
  email      String?
  address    String?
  occupation String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  students StudentGuardian[]

  @@index([schoolId, phone])
  @@index([schoolId, lastName, firstName])
  @@map("guardians")
}

model StudentGuardian {
  id           String               @id @default(cuid())
  studentId    String
  student      Student              @relation(fields: [studentId], references: [id], onDelete: Cascade)
  guardianId   String
  guardian     Guardian             @relation(fields: [guardianId], references: [id], onDelete: Cascade)
  relationship GuardianRelationship
  isPrimary    Boolean              @default(false)
  livesWith    Boolean              @default(false)
  canPickup    Boolean              @default(true)
  createdAt    DateTime             @default(now())

  @@unique([studentId, guardianId])
  @@index([guardianId])
  @@map("student_guardians")
}

model Enrollment {
  id                String           @id @default(cuid())
  studentId         String
  student           Student          @relation(fields: [studentId], references: [id], onDelete: Restrict)
  campusId          String
  campus            Campus           @relation(fields: [campusId], references: [id], onDelete: Restrict)
  academicSessionId String
  academicSession   AcademicSession  @relation(fields: [academicSessionId], references: [id], onDelete: Restrict)
  classArmId        String
  classArm          ClassArm         @relation(fields: [classArmId], references: [id], onDelete: Restrict)
  status            EnrollmentStatus @default(CURRENT)
  startsOn          DateTime         @db.Date
  endsOn            DateTime?        @db.Date
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@unique([studentId, academicSessionId])
  @@index([campusId, classArmId, status])
  @@index([academicSessionId, status])
  @@map("enrollments")
}

model StudentDocument {
  id           String   @id @default(cuid())
  studentId    String
  student      Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  campusId     String
  campus       Campus   @relation(fields: [campusId], references: [id], onDelete: Restrict)
  name         String
  storageKey   String   @unique
  fileName     String
  contentType  String
  sizeBytes    Int
  uploadedById String
  uploadedBy   User     @relation(fields: [uploadedById], references: [id], onDelete: Restrict)
  createdAt    DateTime @default(now())

  @@index([studentId, createdAt(sort: Desc)])
  @@index([campusId, createdAt(sort: Desc)])
  @@map("student_documents")
}

model FeeCategory {
  id          String   @id @default(cuid())
  schoolId    String
  school      School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name        String
  code        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  structures FeeStructure[]
  charges    StudentCharge[]

  @@unique([schoolId, code])
  @@unique([schoolId, name])
  @@index([schoolId, isActive])
  @@map("fee_categories")
}

model FeeStructure {
  id           String      @id @default(cuid())
  schoolId     String
  school       School      @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  campusId     String
  campus       Campus      @relation(fields: [campusId], references: [id], onDelete: Cascade)
  termId       String
  term         Term        @relation(fields: [termId], references: [id], onDelete: Cascade)
  classLevelId String
  classLevel   ClassLevel  @relation(fields: [classLevelId], references: [id], onDelete: Cascade)
  categoryId   String
  category     FeeCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  amount       Decimal     @db.Decimal(12, 2)
  dueOn        DateTime?   @db.Date
  isActive     Boolean     @default(true)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  charges StudentCharge[]

  @@unique([campusId, termId, classLevelId, categoryId])
  @@index([schoolId, termId, isActive])
  @@index([campusId, classLevelId, isActive])
  @@map("fee_structures")
}

/// Finance-owned projection of a Phase 2 student. `studentId` is the stable
/// external key; snapshots keep historical receipts readable after name/class changes.
model StudentFeeAccount {
  id              String    @id @default(cuid())
  schoolId        String
  school          School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  campusId        String
  campus          Campus    @relation(fields: [campusId], references: [id], onDelete: Restrict)
  studentId       String
  admissionNumber String
  displayName     String
  classArmId      String?
  classArm        ClassArm? @relation(fields: [classArmId], references: [id], onDelete: SetNull)
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  charges   StudentCharge[]
  payments  Payment[]
  ledger    FeeLedgerEntry[]
  reminders FeeReminder[]

  @@unique([schoolId, studentId])
  @@unique([schoolId, admissionNumber])
  @@index([campusId, classArmId, isActive])
  @@index([schoolId, displayName])
  @@map("student_fee_accounts")
}

model StudentCharge {
  id             String            @id @default(cuid())
  schoolId       String
  school         School            @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  campusId       String
  campus         Campus            @relation(fields: [campusId], references: [id], onDelete: Restrict)
  accountId      String
  account        StudentFeeAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)
  termId         String
  term           Term              @relation(fields: [termId], references: [id], onDelete: Restrict)
  categoryId     String?
  category       FeeCategory?      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  feeStructureId String?
  feeStructure   FeeStructure?     @relation(fields: [feeStructureId], references: [id], onDelete: SetNull)
  type           StudentChargeType
  description    String
  amount         Decimal           @db.Decimal(12, 2)
  dueOn          DateTime?         @db.Date
  createdAt      DateTime          @default(now())

  allocations PaymentAllocation[]
  reversal    ChargeReversal?

  @@unique([accountId, feeStructureId])
  @@index([accountId, termId, createdAt])
  @@index([campusId, termId, type])
  @@map("student_charges")
}

model ChargeReversal {
  id           String        @id @default(cuid())
  chargeId     String        @unique
  charge       StudentCharge @relation(fields: [chargeId], references: [id], onDelete: Restrict)
  reason       String
  recordedById String
  recordedBy   User          @relation("ChargeReversalRecorder", fields: [recordedById], references: [id], onDelete: Restrict)
  createdAt    DateTime      @default(now())

  @@index([createdAt])
  @@map("charge_reversals")
}

model Payment {
  id            String            @id @default(cuid())
  schoolId      String
  school        School            @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  campusId      String
  campus        Campus            @relation(fields: [campusId], references: [id], onDelete: Restrict)
  accountId     String
  account       StudentFeeAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)
  termId        String
  term          Term              @relation(fields: [termId], references: [id], onDelete: Restrict)
  receiptNumber String            @unique
  method        PaymentMethod
  amount        Decimal           @db.Decimal(12, 2)
  reference     String?
  paidAt        DateTime
  note          String?
  recordedById  String
  recordedBy    User              @relation("PaymentRecorder", fields: [recordedById], references: [id], onDelete: Restrict)
  createdAt     DateTime          @default(now())

  allocations PaymentAllocation[]
  reversal    PaymentReversal?

  @@index([accountId, termId, paidAt(sort: Desc)])
  @@index([campusId, paidAt(sort: Desc), method])
  @@index([schoolId, receiptNumber])
  @@map("payments")
}

model PaymentAllocation {
  id        String        @id @default(cuid())
  paymentId String
  payment   Payment       @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  chargeId  String
  charge    StudentCharge @relation(fields: [chargeId], references: [id], onDelete: Restrict)
  amount    Decimal       @db.Decimal(12, 2)
  createdAt DateTime      @default(now())

  @@unique([paymentId, chargeId])
  @@index([chargeId])
  @@map("payment_allocations")
}

model PaymentReversal {
  id           String   @id @default(cuid())
  paymentId    String   @unique
  payment      Payment  @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  reason       String
  recordedById String
  recordedBy   User     @relation("PaymentReversalRecorder", fields: [recordedById], references: [id], onDelete: Restrict)
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@map("payment_reversals")
}

/// Append-only balance source. Positive amounts increase debt; negative amounts
/// reduce debt. Corrections append an equal-and-opposite REVERSAL entry.
model FeeLedgerEntry {
  id            String            @id @default(cuid())
  schoolId      String
  school        School            @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  campusId      String
  campus        Campus            @relation(fields: [campusId], references: [id], onDelete: Restrict)
  accountId     String
  account       StudentFeeAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)
  termId        String
  term          Term              @relation(fields: [termId], references: [id], onDelete: Restrict)
  type          LedgerEntryType
  amount        Decimal           @db.Decimal(12, 2)
  referenceType String
  referenceId   String
  description   String
  occurredAt    DateTime
  recordedById  String
  recordedBy    User              @relation("FeeLedgerRecorder", fields: [recordedById], references: [id], onDelete: Restrict)
