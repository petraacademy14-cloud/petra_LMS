  name      String
  slug      String
  createdAt DateTime @default(now())

  publications Publication[]

  @@unique([schoolId, slug])
  @@unique([schoolId, name])
  @@map("content_categories")
}

model Publication {
  id            String          @id @default(cuid())
  schoolId      String
  school        School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  campusId      String?
  campus        Campus?         @relation(fields: [campusId], references: [id], onDelete: Restrict)
  categoryId    String?
  category      ContentCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  kind          PublicationKind
  status        ContentStatus   @default(DRAFT)
  slug          String
  title         String
  excerpt       String
  body          String
  tags          String[]        @default([])
  coverImageUrl String?
  eventStartsAt DateTime?
  eventEndsAt   DateTime?
  publishedAt   DateTime?
  authorId      String
  author        User            @relation("PublicationAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  reviewedById  String?
  reviewedBy    User?           @relation("PublicationReviewer", fields: [reviewedById], references: [id], onDelete: Restrict)
  publishedById String?
  publishedBy   User?           @relation("PublicationPublisher", fields: [publishedById], references: [id], onDelete: Restrict)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  media CommunicationMedia[]

  @@unique([schoolId, slug])
  @@index([schoolId, status, publishedAt(sort: Desc)])
  @@index([campusId, status, publishedAt(sort: Desc)])
  @@index([kind, status, eventStartsAt])
  @@map("publications")
}

model CommunicationMedia {
  id            String       @id @default(cuid())
  schoolId      String
  school        School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  campusId      String?
  campus        Campus?      @relation(fields: [campusId], references: [id], onDelete: Restrict)
