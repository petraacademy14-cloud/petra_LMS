# PostgreSQL. Use a separate database for local, preview, and production.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/petra_lms"

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET="replace-with-at-least-32-random-characters"
BETTER_AUTH_URL="http://localhost:3000"

# Self-registration is off by default. Accounts should be invited by an owner/admin.
ALLOW_SELF_SIGN_UP="false"

# Optional deployment metadata used in structured logs.
APP_ENV="development"
APP_VERSION="local"

# Required when seeding a production-like environment.
SEED_OWNER_NAME="Petra Academy Owner"
SEED_OWNER_EMAIL="owner@petraacademy.test"
SEED_OWNER_PASSWORD="replace-with-a-strong-temporary-password"
