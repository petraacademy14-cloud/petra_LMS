# PostgreSQL. Use a separate database for local, preview, and production.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/petra_lms"
# Direct/session connection for Prisma CLI migrations in hosted environments.
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/petra_lms"

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET="replace-with-at-least-32-random-characters"
BETTER_AUTH_URL="http://localhost:3000"

# Self-registration is off by default. Accounts should be invited by an owner/admin.
ALLOW_SELF_SIGN_UP="false"

# Optional deployment metadata used in structured logs.
APP_ENV="development"
APP_VERSION="local"

# Required when seeding a production-like environment.
SEED_OWNER_NAME="Petra Academy Owner"
SEED_OWNER_EMAIL="owner@petraacademy.test"
SEED_OWNER_PASSWORD="replace-with-a-strong-temporary-password"

# Server-only storage access for private student, admissions and communication files.
# Supports the current sb_secret_... format and legacy service_role JWTs.
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SECRET_KEY="replace-with-the-server-only-supabase-secret-key"

# Server-only email delivery for public website contact enquiries.
# Create the API key in Resend and add it to Vercel Preview and Production environments.
RESEND_API_KEY="replace-with-your-resend-api-key"
# Optional. Defaults to Petra Academy Website <enquiries@petraacademy.co> when omitted.
# The sending domain/address must be verified with the email provider.
CONTACT_EMAIL_FROM="Petra Academy Website <enquiries@petraacademy.co>"
