{
  "name": "petra-lms",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "overrides": {
    "postcss": "8.5.25",
    "sharp": "0.35.3"
  },
  "scripts": {
    "dev": "next dev",
    "build": "npm run verify:site-assets && next build",
    "vercel-build": "prisma migrate deploy && node scripts/seed-if-enabled.mjs && node scripts/ensure-storage-buckets.mjs && npm run verify:site-assets && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:ensure-preview-accounts": "tsx scripts/ensure-preview-test-accounts.ts",
    "storage:ensure": "node scripts/ensure-storage-buckets.mjs",
    "verify:site-assets": "node scripts/verify-site-assets.mjs",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build",
    "check:production": "node scripts/verify-production.mjs"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "better-auth": "^1.6.25",
    "lucide-react": "^1.28.0",
    "next": "16.2.12",
    "pdf-lib": "^1.17.1",
    "pg": "^8.22.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "read-excel-file": "^9.3.5",
    "server-only": "^0.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "prisma": "^7.9.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
